{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "com.yasyf.cc-interact.interaction/v1",
  "title": "cc-interact shared interaction schema",
  "$defs": {
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {"type": "string"},
        "claude_pid": {"type": "integer"},
        "scope": {"type": "string"},
        "consumer": {"type": "string"},
        "body": {}
      }
    },
    "Reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": {"type": "boolean"},
        "error": {"type": "string"},
        "daemon_version": {"type": "string"},
        "subject_id": {"type": "string"},
        "status": {"type": "string"},
        "http_port": {"type": "integer"},
        "allow": {"type": "boolean"},
        "reason": {"type": "string"},
        "body": {}
      }
    }
  },
  "x-routes": {
    "business": {
      "operation": "*",
      "request": {"$ref": "#/$defs/Envelope"},
      "response": {"$ref": "#/$defs/Reply"}
    }
  }
}
